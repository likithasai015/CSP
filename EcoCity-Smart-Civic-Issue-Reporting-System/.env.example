# ==============================================================================
# EcoCity Smart Civic Issue Reporting System - Environment Configuration
# Copy this file to .env for local development.
# NOTE: No database (MongoDB, SQL, etc.) is required. The system runs on a
# centralized in-memory mock-data service that resets on backend restart.
#
# IMPORTANT:
# - NEVER commit real secrets or .env files to GitHub.
# - VITE_ variables are public and exposed to the browser.
# - All other variables are server-only secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Client Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# The public URL of the deployed frontend application (used for CORS authorization)
CLIENT_URL=http://localhost:3000

# Server backend base URL
SERVER_URL=http://localhost:5000

# Frontend API URL (Vite)
# - In local dev with Vite proxy or direct calls: http://localhost:5000/api
# - In unified production deployment: leave empty or '/api'
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. Brevo Transactional Email API (Official Integration)
# ------------------------------------------------------------------------------
# Your official Brevo API v3 key (starts with xkeysib-...)
# Obtain from: Brevo Dashboard -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# The verified sender email registered and validated in your Brevo account
# Obtain from: Brevo Dashboard -> Senders & IP -> Senders
BREVO_SENDER_EMAIL=notifications@yourdomain.com

# Friendly display name for the sender
BREVO_SENDER_NAME=EcoCity Civic System

# Administrator recipient email that receives issue notifications
ADMIN_NOTIFICATION_EMAIL=likithamindi024@gmail.com

# ------------------------------------------------------------------------------
# 3. Security & Administrator Authentication (In-Memory Dummy Credentials)
# ------------------------------------------------------------------------------
# Strong random secret for signing administrator JWT tokens (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here

# Administrator login credentials
ADMIN_EMAIL=likithamindi024@gmail.com
ADMIN_PASSWORD=likitha123
ADMIN_NAME=EcoCity Administrator

# Optional API key for programmatic administrative access via X-Admin-Key header
ADMIN_API_KEY=
