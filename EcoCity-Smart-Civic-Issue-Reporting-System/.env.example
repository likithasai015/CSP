# ==============================================================================
# EcoCity Smart Civic Issue Reporting System - Environment Configuration
# Copy this file to .env for local development, or add these keys to your
# Vercel Project Settings -> Environment Variables for production deployment.
#
# IMPORTANT:
# - NEVER commit real secrets or .env files to GitHub.
# - VITE_ variables are public and exposed to the browser.
# - All other variables are server-only secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Client Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# The public URL of the deployed frontend application (used for CORS authorization)
# Example: https://ecocity.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app

# Server backend base URL (optional, defaults to request host)
# Example: https://ecocity.vercel.app
SERVER_URL=https://your-frontend-domain.vercel.app

# Frontend API URL (Vite)
# - In a Unified Vercel deployment (recommended: frontend & backend on the same domain),
#   leave this empty or set to '/api'.
# - In a Separate Vercel deployment (frontend on one domain, backend on another),
#   set this in the Frontend project settings to: https://your-backend.vercel.app/api
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection string. For Vercel production, use MongoDB Atlas:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ecocity?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ecocity?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Brevo Transactional Email API (Official Integration)
# ------------------------------------------------------------------------------
# Your official Brevo API v3 key (starts with xkeysib-...)
# Obtain from: Brevo Dashboard -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# The administrator email address that receives complaint notifications
ADMIN_EMAIL=admin@yourdomain.com

# The verified sender email registered and validated in your Brevo account
# Obtain from: Brevo Dashboard -> Senders & IP -> Senders
BREVO_SENDER_EMAIL=notifications@yourdomain.com

# Friendly display name for the sender
BREVO_SENDER_NAME=EcoCity Civic System

# ------------------------------------------------------------------------------
# 4. Security & Administrator Authentication
# ------------------------------------------------------------------------------
# Strong random secret for signing administrator JWT tokens (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here

# Initial password for the administrator account
ADMIN_PASSWORD=your_secure_admin_password_here

# Administrator display name
ADMIN_NAME=EcoCity Administrator

# Optional API key for programmatic administrative access via X-Admin-Key header
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 5. Cloudinary Image Storage (Recommended for Vercel Serverless)
# ------------------------------------------------------------------------------
# Free Cloudinary credentials for permanent, high-availability image storage.
# If omitted on Vercel, images fallback to safe embedded Data URIs.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
