# ==============================================================================
# EcoCity Smart Civic Issue Reporting System - Environment Configuration
# Copy this file to .env and supply your real values.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Client Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Frontend API URL (Vite)
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# Local MongoDB service or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ecocity

# ------------------------------------------------------------------------------
# 3. Brevo Transactional Email API (Official Integration)
# ------------------------------------------------------------------------------
# Your official Brevo API v3 key (starts with xkeysib-...)
BREVO_API_KEY=your_brevo_api_key_here

# The administrator email address that receives complaint notifications
ADMIN_EMAIL=admin@yourdomain.com

# The verified sender email registered in your Brevo account
BREVO_SENDER_EMAIL=notifications@yourdomain.com

# Friendly display name for the sender
BREVO_SENDER_NAME=EcoCity Civic System

# ------------------------------------------------------------------------------
# 4. Security & Administrator Authentication
# ------------------------------------------------------------------------------
# Strong secret for signing administrator JWT tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here

# Administrator initial login password (required for admin authentication)
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=EcoCity Administrator

# Optional API key for programmatic administrative access via X-Admin-Key header
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 5. Cloudinary Image Storage (Optional)
# ------------------------------------------------------------------------------
# If left blank, uploaded photos are safely stored locally in /uploads directory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
